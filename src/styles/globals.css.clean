/* Global Variables & Base Styles */

:root {
  /* Sky Blue, White, and Golden Theme */
  --primary-dark: #1565c0;      /* Deep Sky Blue */
  --primary-light: #e3f6fd;     /* Very Light Sky Blue */
  --secondary: #fffbe6;         /* Soft White/Light Gold */
  --accent: #ffd700;            /* Golden */
  --accent-light: #fff8dc;      /* Light Golden */
  --success: #4caf50;
  --warning: #ffb300;
  --info: #0288d1;
  --neutral-100: #ffffff;       /* White */
  --neutral-200: #f0f4f8;       /* Very Light Blue */
  --neutral-300: #e0e7ef;       /* Light Blue */
  --neutral-500: #90caf9;       /* Sky Blue */
  --neutral-700: #1976d2;       /* Sky Blue (darker) */
  --neutral-900: #0d47a1;       /* Deepest Blue */
  --text-primary: #1565c0;      /* Sky Blue */
  --text-secondary: #ffd700;    /* Golden */
  --border-color: #e0e7ef;
  --shadow-sm: 0 1px 3px rgba(21, 101, 192, 0.08);
  --shadow-md: 0 4px 12px rgba(21, 101, 192, 0.12);
  --shadow-lg: 0 8px 24px rgba(21, 101, 192, 0.15);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
  background-color: #f5f7fa;
  color: var(--text-primary);
  line-height: 1.6;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
  font-weight: 600;
  line-height: 1.2;
  color: var(--text-primary);
}

h1 {
  font-size: 2rem;
}

h2 {
  font-size: 1.5rem;
}

h3 {
  font-size: 1.25rem;
}

h4 {
  font-size: 1rem;
}

p {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

/* Buttons */
button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  border-radius: 6px;
  transition: var(--transition);
  font-size: 0.9rem;
  font-weight: 500;
}

/* Input Fields */
input, textarea, select {
  font-family: inherit;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 0.75rem;
  font-size: 0.95rem;
  transition: var(--transition);
}

input:focus, textarea:focus, select:focus {
  outline: none;
  border-color: var(--secondary);
  box-shadow: 0 0 0 3px rgba(15, 52, 96, 0.1);
}

/* Links */
a {
  color: var(--secondary);
  text-decoration: none;
  transition: var(--transition);
}

a:hover {
  color: var(--accent);
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--neutral-100);
}

::-webkit-scrollbar-thumb {
  background: var(--neutral-300);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--neutral-500);
}
